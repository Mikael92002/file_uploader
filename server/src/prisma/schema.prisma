// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  engineType      = "binary"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  folders  Folder[]
}

model Folder {
  id         Int      @id @default(autoincrement())
  folderName String   @db.VarChar(100)
  user       User     @relation(fields: [folderId], references: [id])
  folderId   Int
  files      File[]
  parentId   Int? // once folder is
  // created at the top-level (in home)
  // it lives in a null "parentId"
  // subsequent folders reference
  // "id" from this model
  parent     Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  // "SubFolders" needed to tell prisma
  // about recursive relationship
  children   Folder[] @relation("SubFolders")
}

model File {
  id         Int      @id @default(autoincrement())
  fileName   String   @unique @db.VarChar(100)
  fileURL    String
  size       Decimal  @db.Decimal(5, 2)
  uploadTime DateTime @db.Timestamptz()
  folder     Folder   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId     Int
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
